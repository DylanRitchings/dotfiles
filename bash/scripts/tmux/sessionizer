#!/usr/bin/env bash

parent_dirs=(
  ~/notes
  )

child_dirs=(
  ~/work/repos
  ~/dev/repos
  ~/dev/apps
  )
# Select project directory
if [[ $# -eq 1 ]]; then
    selected=$1
else
  selected=$(
    (
      printf "%s\n" "${parent_dirs[@]}"
      find "${child_dirs[@]}" -mindepth 1 -maxdepth 1 -type d
    ) | fzf
)
  # selected=$( (echo ~/notes; find ~/work/repos ~/dev/repos ~/dev/apps -mindepth 1 -maxdepth 1 -type d ) | fzf)
fi

# Exit if no directory is selected
if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)

# Check if session exists, create if not
if ! tmux has-session -t=$selected_name 2> /dev/null; then
    tmux new-session -ds $selected_name -c $selected
    tmux send-keys -t $selected_name "nvim" C-m
    tmux new-window -t $selected_name -c $selected
fi

echo "$selected_name"
